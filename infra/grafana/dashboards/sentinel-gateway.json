{
  "uid": "sentinel-gateway",
  "title": "Sentinel — gateway, cost & latency",
  "tags": ["sentinel", "llm", "gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "id": 1,
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#22d3ee" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(sentinel_inferences_total[5m]))" }]
    },
    {
      "type": "stat",
      "title": "TTFT p95",
      "id": 2,
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.5 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_time_to_first_token_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Spend / hour",
      "id": 3,
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4 },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(sentinel_cost_usd_total[30m])) * 3600" }]
    },
    {
      "type": "stat",
      "title": "Avoided / hour",
      "id": 4,
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(sentinel_savings_usd_total[30m])) * 3600" }]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "id": 5,
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sentinel:cache_hit_ratio5m" }]
    },
    {
      "type": "stat",
      "title": "In flight",
      "id": 6,
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sentinel_inflight_requests" }]
    },
    {
      "type": "timeseries",
      "title": "Traffic by model and cache state",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 14, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sentinel_inferences_total[5m])) by (model, cache)",
          "legendFormat": "{{model}} · {{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time to first token percentiles",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 6, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(sentinel_time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(sentinel_time_to_first_token_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Spend rate by model",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sentinel_cost_usd_total[15m])) by (model) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Generation throughput (tokens/s)",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 0, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(sentinel_output_tokens_per_second_bucket[10m])) by (le, model))",
          "legendFormat": "{{model}} p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit state (0 closed, 1 half-open, 2 open)",
      "id": 11,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": { "decimals": 0, "max": 2, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sentinel_circuit_state", "legendFormat": "{{provider}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries and rate limiting",
      "id": 12,
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sentinel_upstream_retries_total[15m])) by (provider)",
          "legendFormat": "retry {{provider}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(sentinel_rate_limited_total[15m])) by (reason)",
          "legendFormat": "limited {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tracing cost (span flush duration)",
      "id": 13,
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 8, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_trace_flush_seconds_bucket[10m])) by (le))",
          "legendFormat": "flush p95"
        },
        {
          "refId": "B",
          "expr": "sum(rate(sentinel_spans_recorded_total[5m]))",
          "legendFormat": "spans/s"
        }
      ]
    }
  ]
}
