# ---------------------------------------------------------------------------
# Sentinel configuration. Every value has a working default: copy this to .env
# only to change something. With no provider keys at all the gateway still runs
# on its deterministic local engine.
# ---------------------------------------------------------------------------

# --- identity --------------------------------------------------------------
APP_ENV=local                  # local | staging | production
LOG_LEVEL=INFO
REGION=local
GIT_SHA=dev

# --- persistence -----------------------------------------------------------
# Empty -> SQLite at ./.data/sentinel.db
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# --- auth ------------------------------------------------------------------
# CHANGE BOTH BEFORE THIS IS REACHABLE FROM THE INTERNET.
JWT_SECRET=change-me-in-production
JWT_TTL_MINUTES=720
ADMIN_EMAIL=admin@sentinel.dev
ADMIN_PASSWORD=sentinel
# true -> control-plane GETs need no token (public demo mode)
PUBLIC_READ=true
# true -> /v1 accepts unauthenticated calls (demo only)
ALLOW_ANONYMOUS_INFERENCE=true
CORS_ORIGINS=*

# --- upstreams -------------------------------------------------------------
# Any of these adds a provider to the routing pool. All optional.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Any OpenAI-compatible endpoint: Ollama, vLLM, Groq, Together, OpenRouter.
# COMPAT_BASE_URL=http://localhost:11434/v1
# COMPAT_API_KEY=ollama
# COMPAT_LABEL=ollama
# Force the local engine only, even if keys are present.
SIMULATE_ONLY=false

UPSTREAM_TIMEOUT_SECONDS=90
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=220

# --- resilience ------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30
CIRCUIT_HALF_OPEN_PROBES=2
MAX_CONCURRENCY=64

# --- limits ----------------------------------------------------------------
DEFAULT_RPM_LIMIT=240
DEFAULT_TPM_LIMIT=240000
DEFAULT_MONTHLY_BUDGET_USD=25
MAX_PROMPT_CHARS=120000
MAX_OUTPUT_TOKENS_CAP=8192

# --- caching ---------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_TEMPERATURE=0.25
CACHE_MAX_ENTRIES=20000

# --- observability ---------------------------------------------------------
TRACING_ENABLED=true
TRACE_RETENTION_HOURS=72
SLO_TTFT_MS=1500
SLO_AVAILABILITY=0.995
# Set to an OTLP/HTTP collector to mirror spans out. Requires
# requirements-optional.txt; without it the gateway logs a warning and keeps
# recording spans locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=sentinel-gateway

# --- demo ------------------------------------------------------------------
BOOTSTRAP_DEMO=true            # seed catalogue, policies, a key and warm traffic

# --- console (web/.env.local) ---------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
